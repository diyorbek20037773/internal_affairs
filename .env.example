# Gemini API keys — comma OR newline separated. Multiple keys are used with
# random rotation + automatic failover on rate-limit (429) / quota errors.
# NEVER commit real keys. On Railway set this in Variables (secret).
GEMINI_API_KEYS=key1,key2,key3

# Model id (optional; defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Default UI locale (uz | ru | en)
NEXT_PUBLIC_DEFAULT_LOCALE=uz
