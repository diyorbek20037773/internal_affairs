# Gemini API keys — comma OR newline separated. Multiple keys are used with
# random rotation + automatic failover on rate-limit (429) / quota errors.
# NEVER commit real keys. On Railway set this in Variables (secret).
GEMINI_API_KEYS=key1,key2,key3

# Model id (optional; defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Text-to-speech (optional). Uses the same GEMINI_API_KEYS pool.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# Default UI locale (uz | ru | en)
NEXT_PUBLIC_DEFAULT_LOCALE=uz

# Public site URL (OpenGraph / link previews)
NEXT_PUBLIC_SITE_URL=https://internalaffairs-production.up.railway.app

# Server store (optional). Railway: add the Postgres plugin and reference its
# DATABASE_URL here. Without it the app keeps everything in the tablet's
# localStorage (instructor cabinet then sees only that device).
# DATABASE_URL=postgresql://user:pass@host:5432/railway
# DATABASE_SSL=1   # force TLS on/off (auto: off for *.railway.internal / localhost)
